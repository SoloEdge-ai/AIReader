{
  "name": "aireader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first PDF reading with grounded AI conversations for Windows 11",
  "author": "SoloEdge-ai",
  "engines": {
    "node": ">=24.19.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "node scripts/build-worker.mjs && concurrently -k \"tsx watch apps/core/src/main.ts\" \"vite apps/web --host 127.0.0.1\"",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build-worker.mjs && vitest run",
    "build": "node scripts/build.mjs",
    "desktop:portable": "pnpm build && electron-builder --win portable --x64 --publish never",
    "start": "electron .",
    "test:e2e": "node scripts/desktop-smoke.mjs"
  },
  "main": "dist/desktop/main.cjs",
  "dependencies": {
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "katex": "0.16.22",
    "pdfjs-dist": "5.4.54",
    "pngjs": "7.0.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "tar": "^7.5.22",
    "ws": "8.18.3",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "22.18.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/ws": "8.18.1",
    "concurrently": "9.2.1",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.9",
    "pdf-lib": "1.17.1",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "6.3.6",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "build": {
    "appId": "ai.soloedge.aireader",
    "productName": "AIReader",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@napi-rs/**/*"
    ],
    "win": {
      "icon": "assets/app.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AIReader-Portable-${version}-${arch}.${ext}"
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  }
}
